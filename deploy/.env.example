# Copy to deploy/.env ON THE SERVER; never commit real keys.
# :80 serves HTTP by IP. Set a real hostname after pointing its DNS at Vultr.
SITE_ADDRESS=:80
# Empty uses persistent local JSON, seeded on first startup.
MONGODB_URI=
MONGODB_DB=movein
MAPBOX_ACCESS_TOKEN=
# Public browser token only; requires rebuilding web when changed.
VITE_MAPBOX_TOKEN=
GROK_API_KEY=
GROK_MODEL=grok-4.6
GROK_RESEARCH_MODEL=
GROK_IMAGE_MODEL=grok-imagine-image-2.0
