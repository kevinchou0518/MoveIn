# Copy to .env in the project root. Never commit .env.
# Empty MongoDB URI uses a local persisted demo store.
MONGODB_URI=
MONGODB_DB=movein
# Server-only token for road distances and directions. Empty = labeled estimates.
MAPBOX_ACCESS_TOKEN=
# Optional map tiles in the browser. Use a public, URL-restricted Mapbox token.
VITE_MAPBOX_TOKEN=
# P1, intentionally not required for P0.
GROK_API_KEY=
GROK_MODEL=grok-4.6
# Optional override for natural-language parsing and web-backed price research.
# When empty, GROK_MODEL is used.
GROK_RESEARCH_MODEL=
# Optional AI room preview on bundle results (xAI image edits, billed per image).
GROK_IMAGE_MODEL=grok-imagine-image-2.0
